# Copiar este archivo como .env (el .env NO se sube a GitHub)
DR360_MOTOR=mssql
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=DataRetail360
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Dejar vacío para usar autenticación de Windows. Si usan usuario SQL, completar ambos:
MSSQL_USER=
MSSQL_PASSWORD=
# Sal secreta para seudonimizar el RUT (cambiarla por un texto largo y aleatorio)
DR360_SAL=reemplazar-por-una-sal-secreta-larga
