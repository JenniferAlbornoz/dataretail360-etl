# Entorno virtual (nunca se versiona: se recrea con requirements.txt)
.venv/
venv/
__pycache__/
.ipynb_checkpoints/

# Credenciales y configuración local
.env

# Salidas que se regeneran en cada ejecución
data/gold/
data/*.db
logs/

